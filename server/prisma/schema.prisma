generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model RepairTicket {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requesterName String @default("")
  department    String @default("")
  contact       String @default("")
  location      String @default("")
  assetCode     String @default("")
  priority      String @default("NORMAL")
  version       Int    @default(0)
  items         RequestItem[]
  history       TicketEvent[]

  @@index([createdAt, id])
  @@index([status, createdAt])
}

model RequestItem {
  id        Int @id @default(autoincrement())
  ticketId  Int
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  name      String @db.VarChar(200)
  quantity  Int
  unit      String
  estimatedUnitPrice Decimal? @db.Decimal(12, 2)
  @@index([ticketId])
}

model TicketEvent {
  id        Int @id @default(autoincrement())
  ticketId  Int
  ticket    RepairTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status    String
  actor     String
  note      String @db.Text
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique @db.VarChar(50)
  passwordHash String        @db.VarChar(255)
  displayName  String        @db.VarChar(100)
  role         String        @db.VarChar(30)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
  department   String        @default("") @db.VarChar(100)
  branch       String        @default("") @db.VarChar(100)
  permissions  Json?
  deletedAt    DateTime?

  @@index([role, active])
}

model AuthSession {
  id        String   @id @default(cuid()) @db.VarChar(30)
  tokenHash String   @unique @db.Char(64)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  action        String   @db.VarChar(50)
  actorId       Int?
  actorUsername String   @default("") @db.VarChar(50)
  target        String   @default("") @db.VarChar(100)
  details       String   @db.Text
  createdAt     DateTime @default(now())
  @@index([createdAt, id])
  @@index([actorId, createdAt])
}
